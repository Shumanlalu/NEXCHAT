{
  "name": "nexchat-server",
  "version": "1.0.0",
  "private": true,
  "description": "NEXCHAT self-hostable encrypted message relay and authentication server",
  "license": "AGPL-3.0-only",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@fastify/cors": "9.0.1",
    "@fastify/helmet": "11.1.1",
    "@fastify/rate-limit": "9.1.0",
    "@fastify/websocket": "10.0.1",
    "dotenv": "16.4.7",
    "fastify": "4.28.1",
    "jose": "5.9.6",
    "pg": "8.13.1",
    "ws": "8.18.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/ws": "8.5.13",
    "pg-mem": "2.9.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
