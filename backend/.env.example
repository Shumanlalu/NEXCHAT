# NEXCHAT server configuration. Copy to .env and replace every placeholder.
NODE_ENV=development
HOST=0.0.0.0
PORT=8080

# PostgreSQL. Never use the example password in production.
DATABASE_URL=postgres://nexchat:change-me-in-production@localhost:5432/nexchat
DB_POOL_MAX=10
DB_SSL=false

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-bytes

# Public origin used by browser clients and CORS. Android ignores CORS.
CORS_ORIGIN=https://nexchat.example.com

# Lifetime of short-lived access tokens and rotating refresh tokens.
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

# Encrypted envelopes are deleted after acknowledgement or expiry.
ENVELOPE_TTL_DAYS=7
MAX_ENVELOPE_BYTES=131072
MAX_ATTACHMENT_BYTES=524288

# ICE servers returned to Android clients for WebRTC calls.
# A TURN service is required for reliable calls on restrictive networks.
ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]}]
# Example self-hosted coturn entry:
# ICE_SERVERS_JSON=[{"urls":["stun:turn.example.com:3478"],"username":"turnuser","credential":"turnsecret"}]

TRUST_PROXY=false
LOG_LEVEL=info
