# NEXCHAT relay configuration for a Supabase-hosted database.
# Copy to .env (never commit it) and replace every placeholder.
#
# Use the connection pooler string from:
# Supabase Dashboard -> Connect -> Connection string -> URI
# The password is the database password, not your Supabase account password.

NODE_ENV=production
HOST=0.0.0.0
PORT=8080

DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require
DB_POOL_MAX=10
DB_SSL=true

JWT_SECRET=<generate-a-new-48-byte-base64url-secret>
CORS_ORIGIN=https://nexchat.example.com

ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

ENVELOPE_TTL_DAYS=7
MAX_ENVELOPE_BYTES=131072
MAX_ATTACHMENT_BYTES=524288

ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]}]

TRUST_PROXY=true
LOG_LEVEL=info
